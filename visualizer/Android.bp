cc_library_shared {
    name: "libqcomvisualizer",
    relative_install_path: "soundfx",
    vendor: true,
    srcs: ["offload_visualizer.c"],
    cflags: [
        "-fvisibility=hidden",
        "-Wno-unused-variable",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
        "libdl",
        "libhardware",
        "libtinyalsa",
    ],
    header_libs: [ "libhardware_headers", "libsystem_headers", "libaudio_system_headers"],
    include_dirs: [
        "external/tinyalsa/include",
        "system/media/audio_effects/include",
    ],
}